generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// users + role (bổ sung A1: phân quyền customer/admin)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  email     String   @unique @db.VarChar(100)
  address   String?  @db.Text
  role      String   @default("customer") @db.VarChar(20)
  emailVerified Boolean @default(false) @map("email_verified")
  isLocked  Boolean  @default(false) @map("is_locked")
  resetTokenHash String? @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpires DateTime? @map("reset_token_expires")
  verifyTokenHash String? @map("verify_token_hash") @db.VarChar(64)
  verifyTokenExpires DateTime? @map("verify_token_expires")
  createdAt DateTime @default(now()) @map("created_at")

  cart   Cart?
  orders Order[]
  ratings Rating[]
  reviews Review[]

  @@map("users")
}

/// Giỏ hàng: quan hệ 1-1 với user (user_id unique)
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Bổ sung A3: không cho trùng 1 sản phẩm trong cùng giỏ
  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

/// Đánh giá sao 1–5 của khách hàng (mỗi user 1 vote / sản phẩm)
model Rating {
  id        String   @id @default(dbgenerated("'DG-' || lpad(nextval('ratings_code_seq')::text, 4, '0')")) @db.VarChar(20)
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("ratings")
}

/// Nhận xét chữ của người đã mua (điểm sao đồng bộ sang bảng ratings)
model Review {
  id        String   @id @default(dbgenerated("'NX-' || lpad(nextval('reviews_code_seq')::text, 4, '0')")) @db.VarChar(20)
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model ShippingMethod {
  id            String   @id @default(dbgenerated("'VC-' || lpad(nextval('shipping_methods_code_seq')::text, 4, '0')")) @db.VarChar(20)
  name          String   @db.VarChar(100)
  fee           Decimal  @default(0) @db.Decimal(15, 2)
  estimatedDays String?  @map("estimated_days") @db.VarChar(50)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("shipping_methods")
}

model Order {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  shippingMethodId String   @map("shipping_method_id") @db.VarChar(20)
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  status           String   @default("pending") @db.VarChar(50)
  paymentMethod    String   @default("cod") @map("payment_method") @db.VarChar(20)
  paymentStatus    String   @default("unpaid") @map("payment_status") @db.VarChar(20)
  shippingAddress  String   @map("shipping_address") @db.Text
  shippingPhone    String   @map("shipping_phone") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

/// price = giá tại thời điểm đặt hàng (snapshot, A4)
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

/// Bổ sung A2: slug để map ổn định sang bảng chi tiết
model Category {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(50)

  products Product[]

  @@map("categories")
}

/// Bảng thương hiệu chuẩn hoá (1-N với products)
model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  products Product[]

  @@map("brands")
}

model Product {
  id            Int      @id @default(autoincrement())
  categoryId    Int      @map("category_id")
  brandId       Int      @map("brand_id")
  name          String   @db.VarChar(255)
  color         String?  @db.VarChar(50)
  stockQuantity Int      @default(0) @map("stock_quantity")
  imageUrl      String   @map("image_url") @db.Text
  price         Decimal  @default(0) @db.Decimal(15, 2)
  rating        Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount   Int      @default(0) @map("rating_count")
  createdAt     DateTime @default(now()) @map("created_at")

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]
  ratings    Rating[]
  reviews    Review[]
  mouse      Mouse?
  keyboard   Keyboard?
  headphone  Headphone?
  setup      Setup?
  mousepad   Mousepad?

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

/// Thông số riêng của chuột (1-1 với products)
model Mouse {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique @map("product_id")
  connectivity    String   @db.VarChar(50) // wired | wireless | tri_mode
  handOrientation String   @map("hand_orientation") @db.VarChar(20) // symmetrical | ergonomic
  weightG         Decimal  @map("weight_g") @db.Decimal(5, 1)
  pollingRateHz   Int      @default(1000) @map("polling_rate_hz")
  switchType      String?  @map("switch_type") @db.VarChar(100)
  sensor          String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("mice")
}

/// Thông số riêng của bàn phím cơ (1-1 với products)
model Keyboard {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique @map("product_id")
  connectivity    String   @db.VarChar(50) // wired | wireless | tri_mode
  layout          String   @db.VarChar(50) // 60% | 65% | 75% | TKL | Fullsize
  hasRapidTrigger Boolean  @default(false) @map("has_rapid_trigger")
  hasHotswap      Boolean  @default(true) @map("has_hotswap")
  supportMacos    Boolean  @default(false) @map("support_macos")
  pollingRateHz   Int      @default(1000) @map("polling_rate_hz")
  switch          String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("keyboards")
}

/// Thông số riêng của tai nghe & soundcard (1-1 với products)
model Headphone {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique @map("product_id")
  connectivity  String   @db.VarChar(50) // wired_3.5mm | wireless_2.4g | bluetooth
  headphoneType String   @map("headphone_type") @db.VarChar(50) // in_ear | over_ear | on_ear | soundcard
  hasMic        Boolean  @default(true) @map("has_mic")
  hasAnc        Boolean  @default(false) @map("has_anc")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("headphones")
}

/// Bàn / ghế / arm / phụ kiện công thái học (1-1 với products)
model Setup {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique @map("product_id")
  setupCategory String   @map("setup_category") @db.VarChar(50) // chair | desk | arm | accessory
  maxLoadKg     Int?     @map("max_load_kg")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("setups")
}

/// Thông số riêng của lót chuột (1-1 với products)
model Mousepad {
  id           Int      @id @default(autoincrement())
  productId    Int      @unique @map("product_id")
  padType      String?  @map("pad_type") @db.VarChar(50)
  mouseControl String?  @map("mouse_control") @db.VarChar(50)
  speed        String?  @map("speed") @db.VarChar(50)
  surface      String?  @map("surface") @db.VarChar(100)
  base         String?  @map("base") @db.VarChar(100)
  size         String?  @map("size") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("mousepads")
}
