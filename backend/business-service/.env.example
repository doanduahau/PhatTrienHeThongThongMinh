# Cổng server
PORT=3000
NODE_ENV=development

# Kết nối PostgreSQL/Supabase. KHÔNG commit file .env thật.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gear_shop?schema=public"
# Nếu dùng Supabase, thay bằng connection string của bạn:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Xác thực
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ML service (chạy bằng venv, xem ../ml-service/README.md)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1200
# Phải trùng ML_INTERNAL_TOKEN trong ../ml-service/.env (nếu có đặt)
ML_INTERNAL_TOKEN=doi_thanh_chuoi_bi_mat_noi_bo

# Tài khoản admin mặc định do prisma/seed.js tạo
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@gearshop.vn
SEED_ADMIN_PASSWORD=admin123
