{
  "info": {
    "name": "Gear Shop Backend",
    "description": "Bộ sưu tập API cho backend shop gear gaming. Chạy request Login trước để tự lưu biến {{token}} và {{adminToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "shippingMethodId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Đăng ký",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"khachmoi\",\n  \"email\": \"khachmoi@test.vn\",\n  \"password\": \"123456\",\n  \"address\": \"12 Nguyễn Huệ, TP.HCM\"\n}"
            }
          }
        },
        {
          "name": "Đăng nhập (khách)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.set('token', pm.response.json().data.token);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"khachhang1\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Đăng nhập (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.set('adminToken', pm.response.json().data.token);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Hồ sơ của tôi",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Danh mục",
      "item": [
        {
          "name": "Danh sách danh mục",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" }
        },
        {
          "name": "Tạo danh mục (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ghế gaming\",\n  \"slug\": \"ghe-gaming\"\n}" }
          }
        },
        {
          "name": "Cập nhật danh mục (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Chuột gaming\"\n}" }
          }
        },
        {
          "name": "Xoá danh mục (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "3. Sản phẩm",
      "item": [
        {
          "name": "Danh sách + lọc + phân trang",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=10&slug=chuot&search=logi&sort=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "slug", "value": "chuot" },
                { "key": "search", "value": "logi" },
                { "key": "sort", "value": "price_asc" }
              ]
            }
          }
        },
        {
          "name": "Chi tiết sản phẩm",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Tạo sản phẩm chuột (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.set('productId', pm.response.json().data.id);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"Chuột demo Postman\",\n  \"color\": \"Đen\",\n  \"price\": 990000,\n  \"stockQuantity\": 10,\n  \"imageUrl\": \"https://example.com/mouse.png\",\n  \"detail\": {\n    \"brand\": \"DemoBrand\",\n    \"connectivity\": \"wireless\",\n    \"handOrientation\": \"symmetrical\",\n    \"weightG\": 62,\n    \"pollingRateHz\": 1000,\n    \"switchType\": \"Omron\",\n    \"sensor\": \"Hero 2\"\n  }\n}"
            }
          }
        },
        {
          "name": "Cập nhật sản phẩm (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"price\": 890000,\n  \"stockQuantity\": 8\n}" }
          }
        },
        {
          "name": "Xoá sản phẩm (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "4. Giỏ hàng (cần token khách)",
      "item": [
        {
          "name": "Xem giỏ",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Thêm vào giỏ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/cart/items",
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}" }
          }
        },
        {
          "name": "Sửa số lượng (0 = xoá)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/cart/items/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" }
          }
        },
        {
          "name": "Xoá 1 dòng",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/cart/items/{{productId}}"
          }
        },
        {
          "name": "Xoá toàn bộ giỏ",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/cart"
          }
        }
      ]
    },
    {
      "name": "5. Vận chuyển",
      "item": [
        {
          "name": "Danh sách phương thức",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipping-methods" }
        },
        {
          "name": "Tạo phương thức (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/shipping-methods",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Giao hàng tiết kiệm\",\n  \"fee\": 20000,\n  \"estimatedDays\": \"5-7 ngày\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Cập nhật phương thức (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/shipping-methods/{{shippingMethodId}}",
            "body": { "mode": "raw", "raw": "{\n  \"fee\": 25000\n}" }
          }
        },
        {
          "name": "Xoá phương thức (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/shipping-methods/{{shippingMethodId}}"
          }
        }
      ]
    },
    {
      "name": "6. Đơn hàng (khách)",
      "item": [
        {
          "name": "Đặt hàng (checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.set('orderId', pm.response.json().data.id);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingMethodId\": {{shippingMethodId}},\n  \"shippingAddress\": \"123 Nguyễn Trãi, Q.5, TP.HCM\",\n  \"shippingPhone\": \"0901234567\"\n}"
            }
          }
        },
        {
          "name": "Danh sách đơn của tôi",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders?page=1&limit=10&status=pending"
          }
        },
        {
          "name": "Chi tiết đơn",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          }
        },
        {
          "name": "Huỷ đơn (chỉ khi pending)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "7. Quản trị đơn hàng (admin)",
      "item": [
        {
          "name": "Tất cả đơn hàng",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/orders?page=1&limit=20&status=pending"
          }
        },
        {
          "name": "Đổi trạng thái",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}" }
          }
        }
      ]
    }
  ]
}
